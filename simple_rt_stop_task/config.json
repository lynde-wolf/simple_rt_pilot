[
    {
        "name": "Simple RT Stop Task",
        "template": "jspsych",
        "run": [
            "static/js/math.min.js",
            "static/jspsych7/jspsych.js",
            "static/jspsych7/plugin-instructions.js",
            "static/jspsych7/plugin-html-keyboard-response.js",
            "static/jspsych7/plugin-html-button-response.js",
            "static/jspsych7/plugin-survey-text.js",
            "static/jspsych7/plugin-fullscreen.js",
            "static/jspsych7/plugin-call-function.js",
            "static/jspsych7/poldrack-plugins/plugin-stop-signal.js",
            "static/jspsych7/poldrack-plugins/plugin-attention-check.js",
            "static/jspsych7/jspsych.css",
            "static/css/default_style.css",
            "style.css",
            "experiment.js"
        ],
        "exp_id": "simple_rt_stop_task",
        "cognitive_atlas_task_id": "tsk_4a57abb949e1c",
        "contributors": [
            "Lynde Wolf Gorneault",
            "Patrick Bissett",
            "Ross Blair",
            "Russell Poldrack"
        ],
        "time": 15,
        "reference": "https://psycnet.apa.org/record/2023-31463-001",
        "notes": "Simple RT stop-signal task: comma-key (right index finger) response to triangle/diamond (no choice). 1/3 of trials are stop trials with a star around the shape after a tracked SSD (start 250 ms, +/-50 ms staircase, [0, 1000]). 3 test blocks x 60 trials = 180 trials (~60 stop).",
        "publish": "True",
        "experiment_variables": [
            {
                "name": "credit_var",
                "type": "credit",
                "datatype": "boolean",
                "description": "True if avg_rt > 200"
            }
        ],
        "deployment_variables": {
            "jspsych_init": {
                "fullscreen": true,
                "display_element": "getDisplayElement",
                "on_trial_finish": "addID('simple_rt_stop_task')"
            }
        }
    }
